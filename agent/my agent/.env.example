# Copy to .env. Never commit .env. Set a fresh random PostgreSQL password.
POSTGRES_PASSWORD=replace-with-a-long-random-password
BIND_HOST=127.0.0.1
HTTP_PORT=8080
COOKIE_SECURE=false
SESSION_HOURS=12
MAX_UPLOAD_MB=20
RESULT_LIMIT=1000
QUERY_TIMEOUT_MS=5000
PLAN_MINUTES=10
MUTATION_LIMIT=1000

# No model calls by default. mock is ONLY an automated/local demonstration substitute.
MODEL_PROVIDER=disabled
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
MODEL_PROTOCOL_VERIFIED=false
MODEL_ALLOWED_DATA=false
MODEL_SEND_SAMPLES=false
TRUSTED_ORIGINS=
MODEL_TIMEOUT=30
MODEL_RETRIES=2
MODEL_CONCURRENCY=4
MODEL_REQUEST_TEMPLATE={"model":"$model","input":"$prompt"}
MODEL_RESPONSE_PATH=output
MODEL_AUTH_HEADER=Authorization
MODEL_AUTH_PREFIX="Bearer "
MODEL_EXTRA_HEADERS={}
MODEL_REASONING_EFFORT=high
MODEL_STORE=false

# Only configure after checking the relay's official protocol and data permissions.
# MODEL_PROVIDER=openai_chat: explicitly verified chat-completions protocol only.
# MODEL_PROVIDER=openai_responses: explicitly verified /v1/responses protocol only.
# MODEL_PROVIDER=generic_json: configure documented request/response paths in README.
# No assumption about JSON Schema, tool calling or streaming.
